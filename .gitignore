*.class
*.jar
*.war
*.ear
*.nar

# ── 日志 ──────────────────────────────────────────────────────
*.log
logs/

# ── 本地配置（含密码，不提交） ─────────────────────────────────
src/main/resources/application-local.yml
src/main/resources/application-local.yaml

# ── IDE ───────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath

# ── macOS ─────────────────────────────────────────────────────
.DS_Store

# ── 测试覆盖率报告 ─────────────────────────────────────────────
/surefire-reports/
/jacoco.exec

# pytest artifacts
allure-results/
junit-report.xml
.pytest_cache/
__pycache__/
